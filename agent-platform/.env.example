# CodeVaa Agent Platform — Environment Variables
# Copy to .env and fill in values

# Platform server
CODEVA_PLATFORM_PORT=4000
CODEVA_PLATFORM_HOST=127.0.0.1

# Backend API (must be running)
CODEVA_BACKEND_URL=http://localhost:3000

# Auth — use the same CLI session token as the backend
CODEVA_CLI_SESSION=your-cli-session-token-here

# Codeva API key for "codeva ask <agent> ..." (optional; falls back to anonymous)
CODEVA_API_KEY=sk_cyber_your_key_here

# Concurrency
CODEVA_MAX_PARALLEL=4
CODEVA_AGENT_TIMEOUT=120000
CODEVA_ORCH_TIMEOUT=600000

# Logging
LOG_LEVEL=info
