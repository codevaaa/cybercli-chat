{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@cybermind/codic-runtime": ["../../cybercoder/packages/codic-runtime/src/index.ts"],
      "@cybermind/core": ["../../cybercoder/packages/core/src/index.ts"],
      "@cybermind/shared": ["../../cybercoder/packages/codic-runtime/src/shared-bridge.ts"],
      "@cybermind/tools": ["../../cybercoder/packages/tools/src/index.ts"],
      "@cybermind/providers": ["../../cybercoder/packages/providers/src/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "electron.vite.config.ts", "vite.config.ts", "vitest.config.ts"]
}
